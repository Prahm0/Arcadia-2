{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arcadia-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  // Non-secret runtime config. Secrets (OPENAI_API_KEY, RESEND_API_KEY,
  // TOKEN_ENCRYPTION_KEY) are set with `wrangler secret put` and must never
  // be committed here.
  "vars": {
    "APP_ORIGIN": "https://arcadiahq.app",
    "MAIL_FROM": "Arcadia <hello@arcadiahq.app>",
    "OPENAI_MODEL": "gpt-4o-mini",
    // Laying out the week is a real planning problem, so it gets a reasoning model.
    "OPENAI_PLAN_MODEL": "gpt-5-mini",
    // Stripe price IDs — not secret. Live-mode ids, copied over from the
    // sandbox products after the account was activated. Amounts match the
    // sandbox: Pro $4.95/$12.82/$49.40, Max $9.95/$34.54/$205.40 (AUD).
    "STRIPE_PRICE_PRO_WEEKLY": "price_1UIO8W9e8rebDtOcmpM05x4B",
    "STRIPE_PRICE_PRO_MONTHLY": "price_1UIO8V9e8rebDtOcsHhFDvcm",
    "STRIPE_PRICE_PRO_YEARLY": "price_1UIO8V9e8rebDtOclg6FUfH0",
    "STRIPE_PRICE_MAX_WEEKLY": "price_1UIO8R9e8rebDtOcnPZs0Nn3",
    "STRIPE_PRICE_MAX_MONTHLY": "price_1UIO8S9e8rebDtOcAXdSoZZa",
    "STRIPE_PRICE_MAX_YEARLY": "price_1UIO8S9e8rebDtOcyuG3u5Ih"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arcadia",
      // Replaced with the real id by `wrangler d1 create arcadia`.
      "database_id": "35051c9c-7dda-42df-8bcf-4b751e321979",
      "migrations_dir": "migrations"
    }
  ],

  // R2 bucket for user-uploaded syllabus PDFs and resources. Arcad still
  // reads each file and persists what it found to D1 regardless; the bucket
  // is what lets us keep the original around so users can re-download it.
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "arcadia-uploads"
    }
  ],

  // Browser push delivery. VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY are
  // secrets, never values in this file.
  "triggers": {
    "crons": ["* * * * *"]
  }
}
