# Copy to `.env.local` and fill in as needed. Every var here is optional —
# omit one and the feature it powers falls back to a local default.

# --- Backend ---------------------------------------------------------------
# Origin of the Cloudflare Worker (Abtin's ~/Arcadia repo). Defaults to the
# production origin when unset.
# ARCADIA_BACKEND_ORIGIN=https://api.arcadia.study

# --- Waitlist -------------------------------------------------------------
# If set, waitlist signups POST here as JSON. Otherwise they're appended to
# `.data/waitlist.jsonl` on the server (dev-only).
# WAITLIST_WEBHOOK_URL=

# --- Sentry ---------------------------------------------------------------
# Server DSN — enables `onRequestError` capture in instrumentation.ts.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# Browser DSN — enables client init in instrumentation-client.ts. Usually
# the same value as SENTRY_DSN, but it's exposed at build-time (public),
# so kept separate in case you want to point them at different projects.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# Optional env label ("production" | "staging" | "preview" | …). Defaults
# to NODE_ENV.
# SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Optional traces sample rate override (default 0.1 on both sides).
# SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Shared token that unlocks GET /api/sentry-test. Only needed if you want
# to fire a real error into the dashboard to verify wiring.
# SENTRY_TEST_TOKEN=<random-string>

# --- iOS App Store billing -------------------------------------------------
# RevenueCat's public iOS SDK key and the six App Store product IDs. These are
# baked into the iOS web UI at build time, so they must also be GitHub Actions
# secrets for production builds. They are public identifiers, not API secrets.
# NEXT_PUBLIC_REVENUECAT_IOS_API_KEY=appl_...
# NEXT_PUBLIC_REVENUECAT_IOS_PRO_WEEKLY=app.arcadiahq.arcadia.pro.weekly
# NEXT_PUBLIC_REVENUECAT_IOS_PRO_MONTHLY=app.arcadiahq.arcadia.pro.monthly
# NEXT_PUBLIC_REVENUECAT_IOS_PRO_YEARLY=app.arcadiahq.arcadia.pro.yearly
# NEXT_PUBLIC_REVENUECAT_IOS_MAX_WEEKLY=app.arcadiahq.arcadia.max.weekly
# NEXT_PUBLIC_REVENUECAT_IOS_MAX_MONTHLY=app.arcadiahq.arcadia.max.monthly
# NEXT_PUBLIC_REVENUECAT_IOS_MAX_YEARLY=app.arcadiahq.arcadia.max.yearly
