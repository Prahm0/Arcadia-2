{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arcadia-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  // Non-secret runtime config. Secrets (OPENAI_API_KEY, RESEND_API_KEY,
  // TOKEN_ENCRYPTION_KEY) are set with `wrangler secret put` and must never
  // be committed here.
  "vars": {
    "APP_ORIGIN": "https://arcadiahq.app",
    "MAIL_FROM": "Arcadia <hello@arcadiahq.app>",
    "OPENAI_MODEL": "gpt-4o-mini",
    // Laying out the week is a real planning problem, so it gets a reasoning model.
    "OPENAI_PLAN_MODEL": "gpt-5-mini",
    // Pro and Max students plan on a stronger model, a few layouts a day
    // (lib/plan-tier.ts). Max also thinks harder with it.
    "OPENAI_PLAN_MODEL_PRO": "gpt-5",
    "OPENAI_PLAN_MODEL_MAX": "gpt-5",
    // Reading students' files (course outlines, resources) and writing cards
    // and sheets from them. gpt-4o-mini bills each PDF page like gpt-4o does.
    "OPENAI_DOCUMENT_MODEL": "gpt-5-mini",
    // Stripe price IDs — not secret. Live-mode ids, copied over from the
    // sandbox products after the account was activated. Amounts match the
    // sandbox: Pro $4.95/$12.82/$49.40, Max $9.95/$34.54/$205.40 (AUD).
    "STRIPE_PRICE_PRO_WEEKLY": "price_1UImcr9e8rebDtOcpjakTCxb",
    "STRIPE_PRICE_PRO_MONTHLY": "price_1UImdr9e8rebDtOcSF1UJoXs",
    "STRIPE_PRICE_PRO_YEARLY": "price_1UIme39e8rebDtOc4neAYi5g",
    "STRIPE_PRICE_MAX_WEEKLY": "price_1UImh99e8rebDtOcRg3WSl9V",
    "STRIPE_PRICE_MAX_MONTHLY": "price_1UImhN9e8rebDtOckTgt2JRz",
    "STRIPE_PRICE_MAX_YEARLY": "price_1UImhc9e8rebDtOc6mo8AfL0",
    // Coupon applied to the onboarding win-back offer (41% off Pro monthly).
    // Create a 41%-off coupon in Stripe and paste its id here. Empty = no
    // discount (the offer still works, just at full price).
    "STRIPE_WINBACK_COUPON_ID": "2YtHgbRQ",
    // RevenueCat entitlement identifiers. Product identifiers and public SDK
    // keys live in the iOS/web build environment, while the secret API key
    // below is set with `wrangler secret put`.
    "REVENUECAT_ENTITLEMENT_PRO": "pro",
    "REVENUECAT_ENTITLEMENT_MAX": "max",
    "APPLE_BUNDLE_ID": "app.arcadiahq.arcadia",
    // PostHog for server-side events (lib/posthog.ts). The project key is
    // public by design; it's the same one the browser bundle ships with.
    "POSTHOG_KEY": "phc_kWBHKrQWB7pvNdMT4GhnXRtnxZrzqR9x6r2VPEtAjYJA",
    "POSTHOG_HOST": "https://eu.i.posthog.com"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arcadia",
      // Replaced with the real id by `wrangler d1 create arcadia`.
      "database_id": "35051c9c-7dda-42df-8bcf-4b751e321979",
      "migrations_dir": "migrations"
    }
  ],

  // R2 bucket for user-uploaded syllabus PDFs and resources. Arcad still
  // reads each file and persists what it found to D1 regardless; the bucket
  // is what lets us keep the original around so users can re-download it.
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "arcadia-uploads"
    }
  ],

  // Browser push delivery. VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY are
  // secrets, never values in this file.
  "triggers": {
    "crons": ["* * * * *"]
  }
}
